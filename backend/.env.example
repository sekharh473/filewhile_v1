# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# -------------------------------------------------------------
# Cloud Storage: Option A (Recommended) - Supabase Storage
# -------------------------------------------------------------
# 100% Free with zero credit card required.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_BUCKET_NAME=filewhile

# -------------------------------------------------------------
# Cloud Storage: Option B - Backblaze B2 (S3-Compatible)
# -------------------------------------------------------------
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# Note: If no cloud variables are provided, Filewhile will automatically
# use local ephemeral server disk storage in backend/uploads/!
